    "react-router-dom": "^6.26.2",
    "stream-json": "^1.9.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.7",
    "concurrently": "^8.2.2",
    "electron": "^31.4.0",
    "eslint": "^9.9.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "vite": "^5.4.21",
    "vitest": "^4.1.7",
    "wait-on": "^7.2.0"
  },
  "description": "Idle Clans Sentinel - Local profiles, logs and evidence",
