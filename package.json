{
  "name": "idle-clans-sentinel",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
